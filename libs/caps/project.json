{
	"name": "caps",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/caps/src",
	"prefix": "caps",
	"projectType": "library",
	"tags": ["scope:caps"],
	"targets": {
		"build": {
			"executor": "@nx/angular:package",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"options": {
				"project": "libs/caps/ng-package.json",
				"tsConfig": "libs/caps/tsconfig.lib.json"
			},
			"configurations": {
				"production": {
					"tsConfig": "libs/caps/tsconfig.lib.prod.json"
				},
				"development": {}
			},
			"defaultConfiguration": "production"
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"configFile": "libs/caps/vite.config.mts"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		}
	}
}
