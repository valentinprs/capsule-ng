{
	"name": "caps",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/caps/src",
	"prefix": "caps",
	"projectType": "library",
	"tags": ["scope:caps"],
	"targets": {
		"build": {
			"executor": "@nx/angular:package",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"options": {
				"project": "libs/caps/ng-package.json",
				"tsConfig": "libs/caps/tsconfig.lib.json"
			},
			"configurations": {
				"production": {
					"tsConfig": "libs/caps/tsconfig.lib.prod.json"
				},
				"development": {}
			},
			"defaultConfiguration": "production",
			"dependsOn": ["^build", "prepare-styles"],
			"inputs": [
				"production",
				"^production",
				"{workspaceRoot}/libs/styles/src/*.css",
				"{workspaceRoot}/tools/caps/prepare-styles.mjs"
			]
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"configFile": "libs/caps/vite.config.mts"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"prepare-styles": {
			"executor": "nx:run-commands",
			"inputs": ["{workspaceRoot}/libs/styles/src/*.css", "{workspaceRoot}/tools/caps/prepare-styles.mjs"],
			"outputs": ["{projectRoot}/.generated/styles"],
			"options": {
				"command": "node tools/caps/prepare-styles.mjs"
			}
		}
	},
	"implicitDependencies": ["styles"]
}
